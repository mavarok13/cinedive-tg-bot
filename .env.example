APP_ENV=local
BOT_MODE=polling
BOT_TOKEN=123456:replace-with-telegram-bot-token
DATABASE_URL=postgresql+asyncpg://cinedive_bot_app:cinedive@localhost:5432/cinedive
DATABASE_ECHO=false
TMDB_API_KEY=replace-with-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
DEFAULT_LANGUAGE=en-US
LOG_LEVEL=INFO
MOOD_SESSION_TTL_HOURS=24
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-long-random-secret
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

BOT_IMAGE=cinedive-tg-bot:local
POSTGRES_DB=cinedive
POSTGRES_PORT=5432
POSTGRES_APP_USER=cinedive_bot_app
POSTGRES_APP_PASSWORD=cinedive
POSTGRES_SUPERUSER_PASSWORD=cinedive-superuser
